# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication Secrets (SET THESE IN YOUR CPANEL ENVIRONMENT)
JWT_SECRET=your_super_strong_random_jwt_secret_minimum_32_characters

# Payment Gateway (Razorpay)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Administrator Account Setup (Optional - for initial setup)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here

# App URLs & CORS Allowed Origins
FRONTEND_URL=https://yourdomain.com
BASE_URL=https://api.yourdomain.com
